PUBLIC_PORT=80
DJANGO_SECRET_KEY=supersecret
DJANGO_SUPERUSER_NAME=admin
DJANGO_SUPERUSER_PASSWORD=123456789
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_ALLOWED_HOSTS=localhost,authproxy
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
# Set to any non-empty value when running behind a TLS-terminating reverse proxy
# that sends the X-Forwarded-Proto header. Makes Django treat requests as https.
DJANGO_X_FORWARDED_HEADER=1
# Timeout for requests to the rdf4j server backend.
RDF4J_TIMEOUT=5
# RDF4J version of the rdf4j image (build argument).
RDF4J_VERSION=6.1.0
# 1: new repositories record their changes in the change log graph (needs WissKI 5 or later).
# Existing repositories: see "Change log" in README.md.
RDF4J_CHANGELOG=0
# Seconds a successful BasicAuth login is remembered (0: check the password on every request).
BASIC_AUTH_CACHE_SECONDS=300
# SSO (Keycloak OpenID Connect)
OPEN_GDB_KEYCLOAK_SERVER_URL=
OPEN_GDB_KEYCLOAK_CLIENT_ID=
OPEN_GDB_KEYCLOAK_CLIENT_SECRET=
OPEN_GDB_KEYCLOAK_ADMIN_GROUP=
OPEN_GDB_KEYCLOAK_REPO_MANAGER_GROUP=gdb-repo-managers
OPEN_GDB_KEYCLOAK_REPOS_CLAIM=gdb_repos
